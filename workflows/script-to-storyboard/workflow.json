    {
      "parameters": {
        "method": "POST",
        "url": "https://ai-gateway.vercel.sh/v1/images/generations",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "vercelAiGatewayApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { model: 'openai/gpt-image-2.5-flare', prompt: $json.scene.imagePrompt, n: 1, size: '1536x1024', quality: 'medium' } }}",
        "options": {
          "response": {},
          "timeout": 120000
        }
      },
      "id": "75718b2f-f01b-4d28-b066-007570673ed6",
      "name": "Generate Scene Image",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1520,
        224
      ],
      "onError": "continueErrorOutput",
      "credentials": {
        "vercelAiGatewayApi": {
          "id": "dzsPvf6zUydrDWNI",
          "name": "GPT 2.5 Flare"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const source = $('Loop Over Scenes').item.json;\nconst scene = source.scene ?? {};\nconst body = $json.body ?? $json;\nconst image = body?.data?.[0] ?? $json?.data?.[0];\nconst statusCode = Number($json.statusCode ?? 200);\nconst b64 = image?.b64_json;\nconst url = image?.url ?? null;\nconst ok = statusCode < 400 && Boolean(b64 || url);\nreturn { json: {\n  id: String(scene.id || ('scene-' + ($itemIndex + 1))),\n  title: String(scene.title || ('Scene ' + ($itemIndex + 1))),\n  narration: String(scene.narration || ''),\n  imagePrompt: String(scene.imagePrompt || ''),\n  imageData: ok && b64 ? 'data:image/png;base64,' + b64 : null,\n  imageUrl: ok ? url : null,\n  imageStatus: ok ? 'completed' : 'failed',\n  error: ok ? null : 'This scene image could not be generated.'\n} };"
      },
      "id": "523316e9-4e27-4e6f-ab74-8fdd73b3a086",
      "name": "Format Scene Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1728,
        160
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const source = $('Loop Over Scenes').item.json;\nconst scene = source.scene ?? {};\nreturn { json: {\n  id: String(scene.id || ('scene-' + ($itemIndex + 1))),\n  title: String(scene.title || ('Scene ' + ($itemIndex + 1))),\n  narration: String(scene.narration || ''),\n  imagePrompt: String(scene.imagePrompt || ''),\n  imageData: null,\n  imageUrl: null,\n  imageStatus: 'failed',\n  error: 'This scene image could not be generated. Please retry this scene.'\n} };"
      },
      "id": "50477997-244a-4674-9377-12740b0712eb",
      "name": "Record Failed Scene",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1728,
        336
      ]
    },
    {
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "destinationFieldName": "scenes",
        "options": {}
      },
      "id": "89d388a4-e734-4c0f-8a79-7d0b6ce81d8d",
      "name": "Collect Storyboard Scenes",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        1920,
        192
      ]
    },
    {
      "parameters": {
        "jsCode": "const scenes = Array.isArray($json.scenes) ? $json.scenes : [];\nconst failedCount = scenes.filter((scene) => scene.imageStatus === 'failed').length;\nreturn [{ json: {\n  status: failedCount === 0 ? 'completed' : (failedCount === scenes.length ? 'failed' : 'partial'),\n  sceneCount: scenes.length,\n  failedCount,\n  scenes\n} }];"
      },
      "id": "c7984ada-c415-4304-8e91-39fce34c2cc2",
      "name": "Build Storyboard Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2144,
        192
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: {\n  statusCode: 502,\n  status: 'error',\n  error: { code: 'STORYBOARD_GENERATION_FAILED', message: 'The storyboard could not be generated. Please try again.' }\n} }];"
      },
      "id": "2bf9ba66-5c81-4565-83a6-fbeb1d648fd2",
      "name": "Build Generation Error Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
