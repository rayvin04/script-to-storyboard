      "parameters": {
        "language": "javaScript",
        "jsCode": "const item=$input.first();const input=item.json?.body&&typeof item.json.body==='object'?item.json.body:(item.json||{});\nconst title=String(input.title||'Storyboard').trim().slice(0,120);\nconst backgroundId=String(input.backgroundId||'').trim().toUpperCase().replace(/[^A-Z0-9-]/g,'-').replace(/-+/g,'-').replace(/^-|-$/g,'');\nconst sceneNumbers=Array.isArray(input.sceneNumbers)?[...new Set(input.sceneNumbers.map(Number).filter(n=>Number.isInteger(n)&&n>0))].sort((a,b)=>a-b):[];\nif(!backgroundId||!sceneNumbers.length)throw new Error('A background ID and scene numbers are required.');\nlet binary=item.binary?.data;\nlet mimeType=String(binary?.mimeType||input.mimeType||'').toLowerCase();\nif(!binary){\n const data=String(input.imageData||'');const match=/^data:(image\\/(?:png|jpe?g|webp));base64,([A-Za-z0-9+/\\r\\n=]+)$/i.exec(data);\n if(!match)throw new Error('A valid base64 image is required.');\n mimeType=match[1].toLowerCase().replace('image/jpg','image/jpeg');\n const bytes=Buffer.from(match[2].replace(/\\s/g,''),'base64');\n if(!bytes.length||bytes.length>12*1024*1024)throw new Error('Image must be between 1 byte and 12 MB.');\n binary=await this.helpers.prepareBinaryData(bytes,'background.'+(mimeType==='image/jpeg'?'jpg':mimeType.split('/')[1]),mimeType);\n}\nif(!mimeType.startsWith('image/'))throw new Error('Only image files are accepted.');\nconst ext=mimeType==='image/jpeg'?'jpg':mimeType.split('/')[1];\nconst slug=title.normalize('NFKD').replace(/[\\u0300-\\u036f]/g,'').toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'').slice(0,48)||'storyboard';\nconst scenePart=sceneNumbers.map(n=>String(n).padStart(2,'0')).join('-');\nconst fileName=String(input.fileName||'').trim()||new Date().toISOString().slice(0,10)+'-'+slug+'-'+backgroundId.toLowerCase()+'-scenes-'+scenePart+'.'+ext;\nbinary.fileName=fileName;binary.mimeType=mimeType;\nreturn[{json:{...input,ok:true,title,backgroundId,sceneNumbers,mimeType,fileName,folderUrl:'https://drive.google.com/drive/folders/153VPM-IBR1T5UIq-TthqtpklyAGwi-UU'},binary:{data:binary}}];",
        "mode": "runOnceForAllItems"
      },
